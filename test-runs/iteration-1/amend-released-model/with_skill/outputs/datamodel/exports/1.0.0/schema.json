{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/models/permit-registry/1.0.0/schema.json",
  "title": "Permit Registry Model",
  "description": "Permits issued by authorities, with their conditions.",
  "$ref": "#/$defs/Permit",
  "$defs": {
    "PermitStatus": {
      "description": "Lifecycle status of a permit.",
      "enum": [
        "applied",
        "granted",
        "refused",
        "revoked"
      ]
    },
    "Address": {
      "description": "Postal address.",
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "maxLength": 200
        },
        "postalCode": {
          "type": "string",
          "maxLength": 10
        },
        "city": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "postalCode",
        "city"
      ],
      "additionalProperties": false
    },
    "Authority": {
      "description": "Public body competent to issue permits.",
      "type": "object",
      "properties": {
        "authorityId": {
          "description": "Persistent URI of the authority.",
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "$ref": "#/$defs/Address"
        }
      },
      "required": [
        "authorityId",
        "name",
        "address"
      ],
      "unevaluatedProperties": false
    },
    "Permit": {
      "description": "Official authorisation granted to an applicant for an activity at a site.",
      "type": "object",
      "properties": {
        "permitId": {
          "description": "Stable identifier of the permit.",
          "type": "string",
          "format": "uuid"
        },
        "reference": {
          "description": "Human-readable file number used by the authority.",
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "$ref": "#/$defs/PermitStatus"
        },
        "decisionDate": {
          "type": "string",
          "format": "date"
        },
        "validUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "siteLocation": {
          "$ref": "https://geojson.org/schema/Polygon.json"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          }
        },
        "issuer": {
          "description": "Reference to Authority by identifier",
          "type": "string",
          "format": "uri"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermitCondition"
          }
        },
        "versionId": {
          "type": "string",
          "description": "Version of this object"
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "permitId",
        "reference",
        "status",
        "siteLocation",
        "issuer"
      ],
      "unevaluatedProperties": false,
      "$comment": "C-001: validUntil must not be before decisionDate."
    },
    "PermitCondition": {
      "description": "Obligation attached to a permit.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "dueDate": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "text"
      ],
      "unevaluatedProperties": false
    }
  }
}
