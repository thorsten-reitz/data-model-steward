{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/models/permit-registry/1.1.0/schema.json",
  "title": "Permit Registry Model",
  "description": "Permits issued by authorities, with their conditions.",
  "$ref": "#/$defs/Permit",
  "$defs": {
    "PermitStatus": {
      "description": "Lifecycle status of a permit.",
      "enum": [
        "applied",
        "granted",
        "refused",
        "revoked"
      ]
    },
    "ConditionCategory": {
      "description": "Category of a permit condition.",
      "type": "string",
      "examples": [
        "environmental",
        "safety",
        "other"
      ],
      "$comment": "extensible code list; known values in examples"
    },
    "Address": {
      "description": "Postal address.",
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "maxLength": 200
        },
        "postalCode": {
          "type": "string",
          "maxLength": 10
        },
        "city": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "postalCode",
        "city"
      ],
      "additionalProperties": false
    },
    "Applicant": {
      "description": "Person or organisation that applied for the permit, as recorded on the permit.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name of the applicant (natural person or contact person).",
          "type": "string",
          "maxLength": 200
        },
        "organisation": {
          "description": "Organisation the applicant acts for, if any.",
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "description": "Postal address of the applicant.",
          "allOf": [
            {
              "$ref": "#/$defs/Address"
            }
          ]
        }
      },
      "required": [
        "name",
        "address"
      ],
      "additionalProperties": false
    },
    "Authority": {
      "description": "Public body competent to issue permits.",
      "type": "object",
      "properties": {
        "authorityId": {
          "description": "Persistent URI of the authority.",
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "$ref": "#/$defs/Address"
        }
      },
      "required": [
        "authorityId",
        "name",
        "address"
      ],
      "unevaluatedProperties": false
    },
    "Permit": {
      "description": "Official authorisation granted to an applicant for an activity at a site.",
      "type": "object",
      "properties": {
        "permitId": {
          "description": "Stable identifier of the permit.",
          "type": "string",
          "format": "uuid"
        },
        "reference": {
          "description": "File number under which the authority handles the permit (business term \"file number\"; the technical/exchange name stays \"reference\", see D-004).",
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "$ref": "#/$defs/PermitStatus"
        },
        "decisionDate": {
          "type": "string",
          "format": "date"
        },
        "validUntil": {
          "description": "Last day of validity (date only). Still populated for 1.0.0 consumers; must equal the local calendar date of validUntilDateTime when both are present (C-003).",
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "deprecated": true
        },
        "validUntilDateTime": {
          "description": "Exact end of validity with time of day and UTC offset (e.g. 2027-03-31T12:00:00+02:00). The permit is valid up to, but not including, this instant.",
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "siteLocation": {
          "$ref": "https://geojson.org/schema/Polygon.json"
        },
        "keywords": {
          "description": "Free keywords. No longer used; producers should stop populating it.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "deprecated": true
        },
        "applicant": {
          "description": "Applicant of the permit. Expected for every permit recorded from 1.1.0 on (C-002); null or absent for older permits whose applicant is unknown.",
          "anyOf": [
            {
              "$ref": "#/$defs/Applicant"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer": {
          "description": "Reference to Authority by identifier",
          "type": "string",
          "format": "uri"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermitCondition"
          }
        },
        "versionId": {
          "type": "string",
          "description": "Version of this object"
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "permitId",
        "reference",
        "status",
        "siteLocation",
        "issuer"
      ],
      "unevaluatedProperties": false,
      "$comment": "C-001: validUntil must not be before decisionDate.; C-002: WARNING LEVEL (documented, not enforced by the schemas) - every permit recorded from 1.1.0 on must have an applicant; older permits may lack it. Cannot invalidate existing data. Candidate for enforcement in 2.0.0 (Q-001).; C-003: Consistency of the validity end (applies only to the new attribute validUntilDateTime, so it cannot invalidate existing data) - the local date of validUntilDateTime must not be before decisionDate, and when validUntil is also present it equals that local date."
    },
    "PermitCondition": {
      "description": "Obligation attached to a permit.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "dueDate": {
          "type": "string",
          "format": "date"
        },
        "category": {
          "description": "Category of the condition. Expected for new conditions; empty for conditions recorded before 1.1.0 until they are classified.",
          "allOf": [
            {
              "$ref": "#/$defs/ConditionCategory"
            }
          ]
        }
      },
      "required": [
        "text"
      ],
      "unevaluatedProperties": false
    }
  }
}
