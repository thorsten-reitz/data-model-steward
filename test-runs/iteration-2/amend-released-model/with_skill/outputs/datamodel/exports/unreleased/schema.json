{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/models/permit-registry/1.0.0/schema.json",
  "title": "Permit Registry Model",
  "description": "Permits issued by authorities, with their conditions.",
  "$ref": "#/$defs/Permit",
  "$defs": {
    "PermitStatus": {
      "description": "Lifecycle status of a permit.",
      "type": "string",
      "enum": [
        "applied",
        "granted",
        "refused",
        "revoked"
      ]
    },
    "ConditionCategory": {
      "description": "Kind of obligation a permit condition imposes.",
      "type": "string",
      "examples": [
        "environmental",
        "safety",
        "other"
      ],
      "$comment": "extensible code list; known values in examples",
      "x-enumLabels": {
        "en": {
          "environmental": "Environmental",
          "safety": "Safety",
          "other": "Other"
        }
      }
    },
    "Address": {
      "description": "Postal address.",
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "maxLength": 200
        },
        "postalCode": {
          "type": "string",
          "maxLength": 10
        },
        "city": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "postalCode",
        "city"
      ],
      "additionalProperties": false
    },
    "Applicant": {
      "description": "Person or organisation that applied for a permit, as recorded on the permit.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name of the applicant (natural person or contact person).",
          "type": "string",
          "maxLength": 200
        },
        "organisation": {
          "description": "Organisation the applicant acts for, if any.",
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "$ref": "#/$defs/Address"
        }
      },
      "required": [
        "name",
        "address"
      ],
      "additionalProperties": false
    },
    "Authority": {
      "description": "Public body competent to issue permits.",
      "type": "object",
      "properties": {
        "authorityId": {
          "description": "Persistent URI of the authority.",
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "$ref": "#/$defs/Address"
        }
      },
      "required": [
        "authorityId",
        "name",
        "address"
      ],
      "unevaluatedProperties": false
    },
    "Permit": {
      "description": "Official authorisation granted to an applicant for an activity at a site.",
      "type": "object",
      "properties": {
        "permitId": {
          "description": "Stable identifier of the permit.",
          "type": "string",
          "format": "uuid"
        },
        "reference": {
          "title": "File number",
          "description": "Human-readable file number used by the authority (called \"file number\" by the clerks).",
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "$ref": "#/$defs/PermitStatus"
        },
        "decisionDate": {
          "type": "string",
          "format": "date"
        },
        "validUntil": {
          "description": "Last day the permit is valid. Kept for existing consumers; must equal the local date of validUntilDateTime when both are present.",
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "deprecated": true
        },
        "validUntilDateTime": {
          "description": "Instant at which the permit ceases to be valid, with time zone offset.",
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "siteLocation": {
          "$ref": "https://geojson.org/schema/Polygon.json"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "deprecated": true
        },
        "applicant": {
          "description": "Applicant of the permit. Optional in the schema because it is unknown for many permits issued before 1.1.0; mandatory for new permits (C-002).",
          "$ref": "#/$defs/Applicant"
        },
        "issuer": {
          "description": "Reference to Authority by identifier",
          "type": "string",
          "format": "uri"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermitCondition"
          }
        },
        "versionId": {
          "type": "string",
          "description": "Version of this object"
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "permitId",
        "reference",
        "status",
        "siteLocation",
        "issuer"
      ],
      "unevaluatedProperties": false,
      "$comment": "C-001: validUntil must not be before decisionDate.; C-002: Every permit created from version 1.1.0 on must have an applicant.; C-003: validUntilDateTime must not be before decisionDate.; C-004: For permits created from 1.1.0 on, if validUntilDateTime is present, validUntil must also be filled with its local calendar date (keeps old consumers informed).; C-005: Derivation rule (not a stored value): a permit is \"expired\" when status = granted and validUntilDateTime (or, if absent, the end of the day validUntil) lies in the past."
    },
    "PermitCondition": {
      "description": "Obligation attached to a permit.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "dueDate": {
          "type": "string",
          "format": "date"
        },
        "category": {
          "description": "Kind of obligation. Optional because existing conditions are not categorised.",
          "$ref": "#/$defs/ConditionCategory"
        }
      },
      "required": [
        "text"
      ],
      "unevaluatedProperties": false
    }
  }
}
