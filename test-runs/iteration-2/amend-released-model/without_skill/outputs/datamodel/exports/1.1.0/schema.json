{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/models/permit-registry/1.1.0/schema.json",
  "title": "Permit Registry Model",
  "description": "Permits issued by authorities, with their conditions.",
  "$ref": "#/$defs/Permit",
  "$defs": {
    "PermitStatus": {
      "description": "Lifecycle status of a permit. 'expired' is not transmitted in 1.x; receivers derive it from validUntil/validUntilTime (D-005).",
      "enum": [
        "applied",
        "granted",
        "refused",
        "revoked"
      ]
    },
    "ConditionCategory": {
      "description": "Category of a permit condition.",
      "enum": [
        "environmental",
        "safety",
        "other"
      ]
    },
    "Address": {
      "description": "Postal address.",
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "maxLength": 200
        },
        "postalCode": {
          "type": "string",
          "maxLength": 10
        },
        "city": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "postalCode",
        "city"
      ],
      "additionalProperties": false
    },
    "Applicant": {
      "description": "Person or organisation that applied for the permit.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name of the applicant (person or contact).",
          "type": "string",
          "maxLength": 200
        },
        "organisation": {
          "description": "Organisation the applicant acts for.",
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "$ref": "#/$defs/Address"
        }
      },
      "required": [
        "name",
        "address"
      ],
      "unevaluatedProperties": false
    },
    "Authority": {
      "description": "Public body competent to issue permits.",
      "type": "object",
      "properties": {
        "authorityId": {
          "description": "Persistent URI of the authority.",
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "$ref": "#/$defs/Address"
        }
      },
      "required": [
        "authorityId",
        "name",
        "address"
      ],
      "unevaluatedProperties": false
    },
    "Permit": {
      "description": "Official authorisation granted to an applicant for an activity at a site.",
      "type": "object",
      "properties": {
        "permitId": {
          "description": "Stable identifier of the permit.",
          "type": "string",
          "format": "uuid"
        },
        "reference": {
          "description": "File number used by the authority (business term: fileNumber). Property name stays 'reference' in 1.x (D-003).",
          "type": "string",
          "maxLength": 40,
          "title": "File number"
        },
        "status": {
          "$ref": "#/$defs/PermitStatus"
        },
        "decisionDate": {
          "type": "string",
          "format": "date"
        },
        "validUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last day of validity. Without validUntilTime valid until end of this day."
        },
        "validUntilTime": {
          "description": "Time of day on validUntil at which the permit expires, local time of the issuing authority, no offset (hh:mm or hh:mm:ss). Absent = end of day. Only allowed together with validUntil (C-003).",
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
        },
        "siteLocation": {
          "$ref": "https://geojson.org/schema/Polygon.json"
        },
        "applicant": {
          "description": "Applicant of the permit. Mandatory for permits created from 1.1.0 go-live (C-002); may be absent for older permits where the applicant is unknown.",
          "$ref": "#/$defs/Applicant"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "deprecated": true,
          "description": "Deprecated since 1.1.0, removal planned in 2.0.0. Senders should omit it; receivers must still accept it."
        },
        "issuer": {
          "description": "Reference to Authority by identifier",
          "type": "string",
          "format": "uri"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermitCondition"
          }
        },
        "versionId": {
          "type": "string",
          "description": "Version of this object"
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "permitId",
        "reference",
        "status",
        "siteLocation",
        "issuer"
      ],
      "unevaluatedProperties": false,
      "$comment": "C-001: validUntil must not be before decisionDate. C-002: applicant mandatory for permits created from 1.1.0 go-live (not schema-enforced). C-003: validUntilTime requires validUntil (enforced via dependentRequired; note a null validUntil is not caught).",
      "dependentRequired": {
        "validUntilTime": [
          "validUntil"
        ]
      }
    },
    "PermitCondition": {
      "description": "Obligation attached to a permit.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "dueDate": {
          "type": "string",
          "format": "date"
        },
        "category": {
          "description": "Category of the condition. Mandatory for conditions created from 1.1.0 go-live (C-004); absent for older conditions.",
          "$ref": "#/$defs/ConditionCategory"
        }
      },
      "required": [
        "text"
      ],
      "unevaluatedProperties": false
    }
  },
  "$comment": "Version 1.1.0. Backward compatible with 1.0.0: every document valid against 1.0.0 is valid against 1.1.0. New properties are optional; send them only to partners that have adopted 1.1.0 (closed content, see D-002/D-008)."
}